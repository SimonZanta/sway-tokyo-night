{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,
    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/spotify", "sway/language", "custom/vpn", "bluetooth", "network", "pulseaudio", "tray", "custom/power"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "11:1": "󰆍",
            "12:2": "󰅩",
            "13:3": "󰆼",
            "21:1": "󰖟",
            "22:2": "󰝚",
            "23:3": "󰈙",
            "4": "4",
            "5": "5",
            "6": "6",
            "7": "7",
            "8": "8",
            "9": "9",
            "10": "10"
        }
    },
    "sway/window": {
        "max-length": 50
    },
    "clock": {
        "format": "󰅐  {:%H:%M}",
        "format-alt": "󰃭  {:%a %d.%m.%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "today": "<span color='#f7768e'><b>{}</b></span>",
                "weeks": "<span color='#73daca'>W{}</span>"
            }
        }
    },
    "custom/spotify": {
        "exec": "playerctl -p spotify metadata --follow --format '󰓇  {{markup_escape(artist)}} - {{markup_escape(title)}}'"
    },
    "sway/language": {
        "format": "󰌌  {short}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "custom/vpn": {
        "exec": "n=$(nmcli -t -f NAME,TYPE con show --active | grep ':vpn$' | cut -d: -f1); if [ -n \"$n\" ]; then printf '󰖂  %s\\n%s connected (right-click to disconnect)\\non\\n' \"$n\" \"$n\"; else printf '󰖂\\nVPN off (right-click to connect)\\noff\\n'; fi",
        "interval": 5,
        "on-click": "nm-connection-editor",
        "on-click-right": "n=$(nmcli -t -f NAME,TYPE con show --active | grep ':vpn$' | cut -d: -f1); if [ -n \"$n\" ]; then nmcli con down \"$n\"; else v=$(nmcli -t -f NAME,TYPE con show | grep ':vpn$' | head -1 | cut -d: -f1); foot -a vpn-prompt -W 60x8 sh -c \"nmcli --ask con up '$v' || sleep 5\"; fi"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{status}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
    },
    "network": {
        "format-ethernet": "󰈀  {ipaddr}",
        "format-wifi": "󰖩  {essid}",
        "format-disconnected": "󰌘  offline",
        "tooltip-format": "{ifname}  {ipaddr}/{cidr}\nvia {gwaddr}\n{bandwidthDownBytes} down  {bandwidthUpBytes} up",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁  muted",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/sway/power-menu.sh"
    }
}
